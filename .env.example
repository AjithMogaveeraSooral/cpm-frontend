# Public base path for API calls. Defaults to same-origin /api (proxied in dev).
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Where the rewrite proxy forwards /api/* to.
API_PROXY_TARGET=http://127.0.0.1:8081

# Google Maps JS API key (marketplace map + property geocoding).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Verified public website/contact values. Missing values are intentionally hidden.
# Set the real production HTTPS origin before building canonical URLs/sitemap.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Verified offline rent-collection details only; no sample accounts are offered.
# Bank transfer needs beneficiary, account, IFSC and bank; UPI needs beneficiary + UPI.
NEXT_PUBLIC_PAY_BENEFICIARY=
NEXT_PUBLIC_PAY_ACCOUNT_NO=
NEXT_PUBLIC_PAY_IFSC=
NEXT_PUBLIC_PAY_BANK=
NEXT_PUBLIC_PAY_BRANCH=
NEXT_PUBLIC_PAY_ACCOUNT_TYPE=
NEXT_PUBLIC_PAY_UPI=
