# Public base path for API calls. Defaults to same-origin /api (proxied in dev).
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Where the rewrite proxy forwards /api/* to.
API_PROXY_TARGET=https://cpm-backend-1035324904785.asia-south1.run.app

# Google Maps JS API key (marketplace map + property geocoding).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
